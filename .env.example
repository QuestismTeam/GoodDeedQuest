# Backend
SECRET_KEY=YOUR_KEY
DATABASE_URL=postgresql+psycopg://gooddeed:gooddeed@localhost:5432/gooddeedquest
REDIS_URL=redis://localhost:6379/0
AI_SERVICE_URL=http://localhost:8001

# 파일 보관소 (로컬 S3 — docker-compose.yml 의 s3 서비스, VersityGW)
# 2026-11 에 AWS S3 를 내리고 로컬로 바꿨다. 아래 값은 docker-compose.yml 과 맞춰져 있다.
# AWS S3 로 되돌리려면 S3_ENDPOINT_URL 을 지우고 키를 AWS 키로 바꾸면 된다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=gooddeed
AWS_SECRET_ACCESS_KEY=gooddeed123
S3_BUCKET_NAME=gooddeedquest-prod
S3_ENDPOINT_URL=http://localhost:9000
# 앱에 내려주는 파일 주소. 비워두면 앱이 백엔드에 접속한 주소(맥 IP)를 따라간다.
# S3_PUBLIC_ENDPOINT_URL=

# AI
OPENAI_API_KEY=YOUR_KEY
GEMINI_API_KEY=YOUR_KEY
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_VISION_MODEL=gemini-2.5-flash
MAX_CAPTION_LENGTH=60   # Validation

# Langchain
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=YOUR_KEY

# kakao
KAKAO_REST_API_KEY=발급받은_REST_API_키
